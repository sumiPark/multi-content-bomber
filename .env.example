# Supabase
# URL must be the full https URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# OpenAI
OPENAI_API_KEY=sk-proj-xxx

# Token encryption (AES-256-CBC — lib/crypto.ts)
# 32 bytes base64. Generate with: openssl rand -base64 32
# 주의: CLAUDE.md/문서가 "GCM"으로 적힌 부분이 있지만 실제 구현은 CBC (iv:hex 포맷).
# 키를 한 번 정하면 절대 변경 금지 — 기존 암호화된 토큰을 못 풀게 된다.
ENCRYPTION_KEY=

# Site URL — used to build OAuth callback URLs
# Dev: http://localhost:3000
# Prod: https://yourapp.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OAuth — Instagram (Meta Developer Console)
# https://developers.facebook.com → 앱 생성 → "Instagram > API setup with Instagram login"
# Valid OAuth Redirect URI에 ${NEXT_PUBLIC_SITE_URL}/api/auth/callback/instagram 등록
# Meta 콘솔에서 "Instagram App ID" / "Instagram App Secret"으로 표시됨
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# OAuth — TikTok (TikTok for Developers)
# https://developers.tiktok.com → 앱 생성 → Login Kit + Content Posting API
# Redirect URI에 ${NEXT_PUBLIC_SITE_URL}/api/auth/callback/tiktok 등록
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# OAuth — YouTube (Google Cloud Console)
# https://console.cloud.google.com → 프로젝트 생성 → "YouTube Data API v3" 활성화
# OAuth 동의 화면 설정 후, "사용자 인증 정보 → OAuth 2.0 클라이언트 ID(웹 애플리케이션)" 발급
# 승인된 리디렉션 URI에 ${NEXT_PUBLIC_SITE_URL}/api/auth/callback/youtube 등록
# 테스트 단계(External + Testing 상태)에서는 동의 화면의 "테스트 사용자"에 본인 Google 계정 추가 필수
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# 발행 큐 — Postgres + GitHub Actions (Phase 4b, BullMQ/Redis 대체)
# ─────────────────────────────────────────────────────────────────────────────
# 즉시 발행 시 서버 액션이 GitHub repository_dispatch로 워크플로를 즉시 깨운다.
# (예약 발행은 30분 cron sweep이 처리 — dispatch 불필요)
#
# GITHUB_REPO            : "owner/name" 형식 (예: sumi/multi-content-bomber)
# GITHUB_DISPATCH_TOKEN  : repository_dispatch 권한 토큰
#   - fine-grained PAT: 이 repo 대상, Repository permissions > Contents: Read and write
#   - 또는 classic PAT: repo 스코프
#   Vercel 환경변수에만 넣으면 됨(클라이언트 노출 금지 — NEXT_PUBLIC_ 접두사 쓰지 말 것).
GITHUB_REPO=owner/multi-content-bomber
GITHUB_DISPATCH_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# GitHub Actions Secrets (워커 process-due.ts 실행용) — .env가 아니라 GitHub에 등록
# ─────────────────────────────────────────────────────────────────────────────
# repo > Settings > Secrets and variables > Actions 에 아래 키를 등록한다
# (.github/workflows/publish.yml의 env 매핑과 1:1):
#   NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY            (워커는 anon 키 불필요 — service_role만 사용)
#   ENCRYPTION_KEY                        (반드시 Vercel과 같은 값 — 토큰 복호화 위해)
#   NEXT_PUBLIC_SITE_URL
#   YOUTUBE_CLIENT_ID, YOUTUBE_CLIENT_SECRET
#   INSTAGRAM_APP_ID, INSTAGRAM_APP_SECRET
#   TIKTOK_CLIENT_KEY, TIKTOK_CLIENT_SECRET
# 빠뜨리면 process-due 실행 중 해당 단계에서 throw — Actions 로그에 어떤 env가
# 비었는지 찍힌다.